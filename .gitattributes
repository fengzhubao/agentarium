# Keep text files stable across Windows, macOS, and Linux.
* text=auto eol=lf

# Binary files must not be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.mov binary
